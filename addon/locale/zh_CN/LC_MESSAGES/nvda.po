msgid "A lot"
msgstr "大量"

#: progressPulse/__init__.py:521 progressPulse/__init__.py:692
#: progressPulse/__init__.py:780
msgid "Progress Pulse"
msgstr "进度脉冲"

#: progressPulse/__init__.py:529
msgid "&Play my sounds for progress bars instead of NVDA's beeps"
msgstr "播放我自己的进度条声音，而不是 NVDA 的蜂鸣音(&P)"

#: progressPulse/__init__.py:541
msgid "Sound to &change:"
msgstr "要更改的声音(&C)："

#: progressPulse/__init__.py:549
msgid "&Sound:"
msgstr "声音(&S)："

#: progressPulse/__init__.py:556
msgid "C&hoose your own file..."
msgstr "选择自定义文件(&H)..."

#: progressPulse/__init__.py:559
msgid "Pla&y"
msgstr "播放(&Y)"

#: progressPulse/__init__.py:566
msgid "How much the p&itch rises as progress goes up:"
msgstr "随着进度上升音调升高的幅度(&I)："

#: progressPulse/__init__.py:574
msgid "Move the sound from &left ear to right ear as progress goes up"
msgstr "随着进度上升将声音从左耳移动到右耳(&L)"

#: progressPulse/__init__.py:580
msgid "&Volume (0 to 100):"
msgstr "音量（0 到 100）(&V)："

#: progressPulse/__init__.py:591
msgid "Let sounds &overlap when several progress bars move at the same time"
msgstr "当多个进度条同时移动时允许声音重叠(&O)"

#: progressPulse/__init__.py:600
msgid "&Announce when a progress bar finishes, for example \"Download complete\""
msgstr "当进度条完成时进行播报，例如“下载完成”(&A)"

#: progressPulse/__init__.py:606
msgid "&Test all sounds"
msgstr "测试所有声音(&T)"

#: progressPulse/__init__.py:618
msgid "None (silent, only the start, halfway and finished sounds play)"
msgstr "无（静音，仅播放开始、半程和结束声音）"

#: progressPulse/__init__.py:621
msgid "None (the regular sound plays)"
msgstr "无（播放常规声音）"

#: progressPulse/__init__.py:625
msgid "Your own file (use the Choose your own file button)"
msgstr "您自己的文件（使用“选择自定义文件”按钮）"

#: progressPulse/__init__.py:628
#, python-brace-format
msgid "Your own file: {file}"
msgstr "您自己的文件：{file}"

#: progressPulse/__init__.py:631
#, python-brace-format
msgid "Your own file: {file} (file not found)"
msgstr "您自己的文件：{file}（未找到文件）"

#: progressPulse/__init__.py:676
msgid "Choose a sound"
msgstr "选择声音"

#: progressPulse/__init__.py:679
msgid "WAV sound files (*.wav)"
msgstr "WAV 声音文件 (*.wav)"

#: progressPulse/__init__.py:690
#, python-brace-format
msgid ""
"This file can't be used.\n"
"\n"
"{error}\n"
"\n"
"Please choose a WAV sound file."
msgstr ""
"无法使用此文件。\n"
"\n"
"{error}\n"
"\n"
"请选择一个 WAV 声音文件。"

#: progressPulse/__init__.py:778
msgid "Turns Progress Pulse sounds on or off (off uses NVDA's normal beeps)"
msgstr "开启或关闭进度脉冲声音（关闭时使用 NVDA 的常规蜂鸣音）"

#: progressPulse/__init__.py:787
msgid "Progress Pulse sounds on"
msgstr "进度脉冲声音已开启"

#: progressPulse/__init__.py:790
msgid "Progress Pulse sounds off, using NVDA beeps"
msgstr "进度脉冲声音已关闭，正在使用 NVDA 蜂鸣音"
